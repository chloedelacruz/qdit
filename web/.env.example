# ---------------------------------------------------------------------------
# qdit web — environment
#
# Copy to `.env.local` (git-ignored) and fill in. Next.js loads `.env.local`
# automatically; only `NEXT_PUBLIC_*` values reach the browser bundle.
#
# Local values below are the fixed defaults printed by `supabase start`.
# For a hosted project: Dashboard -> Project Settings -> API.
# ---------------------------------------------------------------------------

# Supabase project URL. Hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# Publishable key (`sb_publishable_...`); on older projects this is the legacy
# `anon` JWT. Safe to ship to the browser — Row Level Security is what protects
# the data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Legacy alias, read as a fallback by src/lib/supabase/env.ts. Set this INSTEAD
# of the line above if your project still issues an `anon` JWT.
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...replace_me"

# Absolute origin of this app. Used to build OAuth / magic-link redirect URLs,
# which must also be listed in Supabase Auth -> URL Configuration.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Stellar network the UI links to for explorer URLs: testnet | mainnet.
NEXT_PUBLIC_STELLAR_NETWORK="testnet"

# Deployed `milestone_proof` contract. Leave empty to turn on-chain anchoring
# off entirely — the app runs without it, the anchor controls just do not
# render. See contracts/README.md for the deploy record this value comes from.
#
# Public on purpose: a contract id is not a secret, it is the thing a third
# party needs in order to check the claims this app makes.
NEXT_PUBLIC_MILESTONE_PROOF_CONTRACT_ID="CBP3NKXCRUSOJLLUXDF5AIRNPAC6IL7TFJ2KCNL5A2GTKC2MB7M4OHVG"

# ---------------------------------------------------------------------------
# Server-only. No NEXT_PUBLIC_ prefix — never import these into a Client
# Component and never commit real values.
# ---------------------------------------------------------------------------

# Secret key (`sb_secret_...`), formerly the `service_role` JWT. Bypasses RLS
# entirely.
#
# Required for wallet sign-in, which is the only part of the app that uses it —
# see src/lib/auth/wallet-session.ts. It needs exactly two things RLS cannot
# give it: resolving a wallet address to an account across all profiles (the
# caller has no session yet, so there is no auth.uid() for a policy to match),
# and creating the auth.users row for a wallet nobody has signed in with before.
#
# Reached only from the two handlers under src/app/api/auth/wallet/. Never
# import it into a Client Component, and never add it to src/lib/supabase/env.ts
# — that module promises NEXT_PUBLIC_ values only and the browser client imports
# it. Older projects name this SUPABASE_SERVICE_ROLE_KEY, which is read as a
# fallback.
SUPABASE_SECRET_KEY="sb_secret_replace_me"

# Signs the SEP-10 challenge that proves a browser controls a Stellar account.
#
# An ordinary keypair, generated once and never funded — no transaction it signs
# is ever submitted, so it needs no balance and no trustline. Generate one with:
#
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
#
# Keep it stable across deploys. Rotating it invalidates every challenge already
# in flight, which users experience as a sign-in that fails once and then works.
STELLAR_AUTH_SERVER_SECRET="S_replace_me"

# Direct Postgres connection string, for migrations run outside the Supabase CLI.
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ---------------------------------------------------------------------------
# End-to-end tests. `npm run test:e2e` signs in as this user once and reuses the
# session.
#
# It must be the account that **holds the owner persona** in the hosted e2e
# database — not merely an account with membership of some project. `e2e/seed.ts`
# explains why: `board.spec.ts` asserts the owner's name on a card and
# `dashboard.spec.ts` asserts that same task under "My open tasks", which only
# both hold when the signed-in user *is* the owner.
#
# Getting this wrong does not look like a credentials problem. Sign-in succeeds,
# every page renders, and Row Level Security simply returns no rows — so ~50
# specs fail on their empty states and it reads like an app bug. The tell is
# that the `reseed` and `cleanup` projects keep passing: they hold
# SUPABASE_SECRET_KEY and bypass RLS, so when only the browser-session specs
# fail, suspect who is signed in.
# ---------------------------------------------------------------------------
E2E_EMAIL="you@example.com"
E2E_PASSWORD="replace_me"
