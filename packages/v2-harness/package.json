  },
  "dependencies": {
    "@qdit/merkle": "0.1.0",
    "@qdit/milestone-proof-v2-bindings": "0.1.0",
    "@stellar/stellar-sdk": "^16.2.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
