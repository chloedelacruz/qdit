{
  "name": "@qdit/verify",
  "version": "0.1.0",
  "description": "Check a qdit milestone or batch inclusion proof against Stellar testnet without trusting qdit's app or database.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chloedelacruz/qdit.git",
    "directory": "packages/verify"
  },
  "homepage": "https://github.com/chloedelacruz/qdit/tree/main/packages/verify#readme",
  "keywords": [
    "stellar",
    "soroban",
    "qdit",
    "merkle",
    "attestation",
    "verifier"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "qdit-verify": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@qdit/merkle": "0.1.0",
    "@stellar/stellar-sdk": "^16.2.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
